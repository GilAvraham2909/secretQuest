# Copy to .env and fill in. NEVER commit .env.
#
# Standing rule: zero hardcoded secrets anywhere in this repository — every
# value below is read from process.env at runtime, and this file exists so that
# "which variables does this need?" never has to be answered by grepping for a
# leaked one.

# ── Database ──────────────────────────────────────────────────────────────
# Managed Postgres (Supabase / Neon). Tests do not use this: they run PGlite
# in-process from the checked-in migrations, so no database is needed to
# develop or to run the suite.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ──────────────────────────────────────────────────────────────────
# The parent is the only principal. The child never authenticates.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security — must never reach the browser
# bundle, and must never be read from anything under packages/web.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────
# The PARENT is the customer. Webhook signatures are verified against the raw
# request body — a parsed body cannot be verified, and that check is the only
# thing authenticating the webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ── App ───────────────────────────────────────────────────────────────────
# Exactly one origin. CORS compares against this by equality — never echo back
# whatever Origin header arrived.
ALLOWED_ORIGIN=http://localhost:5180
NODE_ENV=development

# ── Art pipeline (tools/) ─────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
